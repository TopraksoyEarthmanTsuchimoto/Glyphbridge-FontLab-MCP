# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.swp
*~

# Python byte code (the tests run with -B, but an import can still create it)
__pycache__/
*.py[cod]

# The MCP server's virtual environment: created on each machine, never shared (see mental-model/RUNBOOK.md)
venv/
.venv/

# Claude Code per-user settings
.claude/settings.local.json

# Fonts: live tests use disposable fonts, which must never be committed
*.vfc
*.vfj
